# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# A leading dot is a subdomain wildcard. The tunnel domains are listed so a
# freshly generated https://<random>.trycloudflare.com host is accepted without
# editing this every time; drop them once you deploy to a fixed hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,.trycloudflare.com,.ngrok-free.dev,.ngrok-free.app,.ngrok.dev,.ngrok.app,.ngrok.io
# Public HTTPS origins AIDA / your tunnel will call you on. Comma separated.
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.dev,https://*.ngrok-free.app,https://*.ngrok.dev,https://*.ngrok.app,https://*.ngrok.io,https://*.trycloudflare.com

# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty to fall back to a local SQLite file (db.sqlite3).
# docker compose sets this to the bundled Postgres service.
# ---------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_DB=aidabank
POSTGRES_USER=aidabank
POSTGRES_PASSWORD=aidabank

# ---------------------------------------------------------------------------
# Tool API
# Every /api/v1/tools/* call must send this as the X-API-Key header.
# Comma separated so you can rotate keys without downtime.
# ---------------------------------------------------------------------------
TOOL_API_KEYS=dev-aida-key-change-me
# Shown on the dashboard Settings page so you can copy/paste URLs into AIDA.
# Set this to your public tunnel/deployment URL once you have one.
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Public URL / tunnel
#
# AIDA needs an address it can reach from the internet. Easiest route:
#
#   1. open Dashboard -> Settings -> Live URL
#   2. paste your free authtoken (dashboard.ngrok.com -> Your Authtoken)
#   3. press Start tunnel
#
# The token below is only a seed for that field -- setting it here is optional,
# and useful when you want a deployment to come up already configured. The
# ngrok controls only appear when the dashboard is browsed from this machine.
#
# The app asks the ngrok agent for its current address, so you never have to
# copy the URL anywhere -- it just appears, along with every tool endpoint
# rebuilt on it. PUBLIC_BASE_URL below is only the fallback for a fixed
# deployment with no tunnel.
# ---------------------------------------------------------------------------
NGROK_AUTHTOKEN=
# Where the app looks for the agent. "ngrok" is the compose service name;
# use http://127.0.0.1:4040/api/tunnels if you run ngrok on the host instead.
NGROK_API_URL=http://ngrok:4040/api/tunnels
# Host port for ngrok's request inspector (http://localhost:4040).
NGROK_INSPECTOR_PORT=4040

# ---------------------------------------------------------------------------
# Authentication policy
# ---------------------------------------------------------------------------
AUTH_SESSION_TTL_SECONDS=900
MAX_PIN_ATTEMPTS=3
LOCKOUT_MINUTES=15
OTP_TTL_SECONDS=300
MAX_OTP_ATTEMPTS=3
# Step-up OTP before a card can be blocked. Recommended ON in production;
# shipped OFF so the recorded demo can run as one uninterrupted phone call.
REQUIRE_OTP_FOR_CARD_BLOCK=false

# ---------------------------------------------------------------------------
# Notification providers
#
# These are SEED values. On first run they are copied into the ProviderSettings
# row in the database, which is the live source of truth from then on and is
# editable at Dashboard -> Settings -> Providers (no restart needed).
# Editing this file afterwards has no effect until you press "Reload from
# environment" on that page.
#
#   EMAIL_PROVIDER: console | smtp | brevo
#   SMS_PROVIDER:   console | twilio | brevo
#
# console -> nothing leaves the box; the message is stored and rendered on the
#            dashboard Notifications page. Good enough for the demo.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
SMS_PROVIDER=console
DEFAULT_NOTIFICATION_CHANNEL=sms
PROVIDER_HTTP_TIMEOUT=10

# Brevo -- one API key covers both transactional email and transactional SMS.
# Key: Brevo -> SMTP & API -> API keys (starts "xkeysib-").
# The sender email must be a verified sender on the account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AIDA Bank
# Alphanumeric sender shown on the SMS, max 11 characters.
BREVO_SMS_SENDER=AIDABank

# SMTP (any mail server; Brevo's relay is smtp-relay.brevo.com:587)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@aidabank.example

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Deprecated single switch. Still honoured as a per-channel default when
# EMAIL_PROVIDER / SMS_PROVIDER are blank.
NOTIFICATION_PROVIDER=console

# ---------------------------------------------------------------------------
# Demo seed data (python manage.py seed_demo)
# ---------------------------------------------------------------------------
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin12345
DEMO_ADMIN_EMAIL=admin@aidabank.example
